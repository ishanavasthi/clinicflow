{
  "id": "S01",
  "split": "development",
  "title": "Normal booking",
  "initial_message": "Hi, I need a General Medicine appointment for persistent cough. I am Asha Nair, age 34, phone 9876501001.",
  "patient": {
    "name": "Asha Nair",
    "phone": "9876501001",
    "department": "General Medicine",
    "symptoms": "persistent cough",
    "age": "34"
  },
  "policy": {
    "max_turns": 12,
    "rules": [
      {
        "id": "r1",
        "match": "\\b(?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)\\b|\\b\\d{1,2}:\\d{2}\\b|these (?:times|options)",
        "reply": "__FIRST_OFFERED_TIME__",
        "once": true
      },
      {
        "id": "r2",
        "match": "appointment|available|availability|slot|time|prefer",
        "reply": "Yes, please tell me the actual available times first.",
        "once": true
      },
      {
        "id": "r3",
        "match": "confirm|book it|shall I book|proceed",
        "reply": "Yes, please book that appointment.",
        "once": true
      }
    ],
    "fallback": null
  },
  "fault": null,
  "expected": {
    "outcome": "book",
    "appointment_count": 1,
    "patient_fields": {
      "name": "Asha Nair",
      "phone": "9876501001"
    },
    "appointment_fields": {
      "department": "General Medicine"
    },
    "require_consent": true,
    "max_appointments": 1
  }
}

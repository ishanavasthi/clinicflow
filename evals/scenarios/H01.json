{
  "id": "H01",
  "split": "holdout",
  "title": "Held-out correction",
  "initial_message": "I need Pediatrics for recurring fever. I am Priya Lal, age 36, phone 9876502001. Correction: my phone is 9876502100.",
  "patient": {
    "name": "Priya Lal",
    "phone": "9876502100",
    "department": "Pediatrics",
    "symptoms": "recurring fever",
    "age": "36"
  },
  "policy": {
    "max_turns": 12,
    "rules": [
      {
        "id": "r1",
        "match": "\\b(?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)\\b|\\b\\d{1,2}:\\d{2}\\b|these (?:times|options)",
        "reply": "__FIRST_OFFERED_TIME__",
        "once": true
      },
      {
        "id": "r2",
        "match": "appointment|available|availability|slot|time|prefer",
        "reply": "Yes, please tell me the actual available times first.",
        "once": true
      },
      {
        "id": "r3",
        "match": "confirm|book it|shall I book|proceed",
        "reply": "Yes, please book that appointment.",
        "once": true
      }
    ],
    "fallback": null
  },
  "fault": null,
  "expected": {
    "outcome": "book",
    "appointment_count": 1,
    "patient_fields": {
      "name": "Priya Lal",
      "phone": "9876502100"
    },
    "appointment_fields": {
      "department": "Pediatrics"
    },
    "require_consent": true,
    "max_appointments": 1,
    "max_patient_records": 1
  }
}

# LiveKit Cloud (same project as the server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Voice pipeline providers
RUMIK_API_KEY=your_rumik_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# ---------------------------------------------------------------------------
# Voice mode
#   cascaded  silero VAD -> Deepgram STT -> LLM -> Rumik TTS (four swappable stages)
#   realtime  one OpenAI speech-to-speech model instead of those three
# ---------------------------------------------------------------------------
VOICE_MODE=cascaded

# --- Cascaded LLM: which provider serves the chat model -------------------
#   groq    openai/gpt-oss-120b, fastest time-to-first-token, free tier is
#           rate limited (8000 tokens/min) and a 429 mid-call is audible
#   openai  gpt-4.1-mini by default, no free-tier limit on a paid key
LLM_PROVIDER=groq

# Per-provider keys. Only the selected provider's key is read, so a Groq key is
# never sent to api.openai.com.
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=

# Optional overrides (each falls back to the provider's default)
# LLM_MODEL=gpt-4.1-mini            # or gpt-5-mini, openai/gpt-oss-120b
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=                      # wins over the provider key above
# LLM_REASONING_EFFORT=low          # 'none' to disable on reasoning models

# --- Realtime mode (VOICE_MODE=realtime), needs OPENAI_API_KEY ------------
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=marin
# REALTIME_TURN_DETECTION=semantic_vad   # semantic_vad | server_vad | none
# REALTIME_EAGERNESS=low                 # semantic_vad only: low waits longest
# REALTIME_NOISE_REDUCTION=near_field    # near_field | far_field | none

# Where the agent persists tool results (the FastAPI server), used from M2
CLINICFLOW_API_URL=http://localhost:8000
